{
	"name": "@doraeyi/content-toolkit",
	"version": "0.1.0",
	"description": "Framework-agnostic markdown content helpers: frontmatter parsing, reading time, and TOC extraction.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"mdast-util-from-markdown": "^2.0.2",
		"mdast-util-to-string": "^4.0.0",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@types/mdast": "^4.0.4",
		"tsup": "^8.5.0",
		"typescript": "^6.0.3"
	}
}
