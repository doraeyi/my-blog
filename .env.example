# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Portfolio sync (admin-triggered) — personal access token with repo read access
# https://github.com/settings/tokens
GITHUB_TOKEN=""
GITHUB_USERNAME=""

# Watch tracker — TMDB API key
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# "Now watching" heartbeat from the browser script (tools/now-watching.user.js)
NOW_WATCHING_TOKEN=""

# /tech-note drafts from Claude Code (POST /api/posts/draft) — long random string
TECH_NOTE_TOKEN=""

# Discord webhook for new comments / likes (channel settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=""
# Set to true to also be notified about your own (owner account) comments and likes
DISCORD_NOTIFY_OWNER=""

# Email (newsletter + friend-link notices) through Resend. Without these the
# subscribe box stays hidden in production; local dev prints emails to the console.
RESEND_API_KEY=""
# A sender on a domain verified in Resend.
MAIL_FROM="Liam 偵探手記 <newsletter@doraeyi.com>"

# Off-site database backups (optional). Any S3-compatible bucket, e.g. Cloudflare R2:
# endpoint https://<account-id>.r2.cloudflarestorage.com, region auto.
# Without these, daily backups are kept on the VM only (data/backups).
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_REGION="auto"
