# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Portfolio sync (admin-triggered) — personal access token with repo read access
# https://github.com/settings/tokens
GITHUB_TOKEN=""
GITHUB_USERNAME=""

# Watch tracker — TMDB API key
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# "Now watching" heartbeat from the browser script (tools/now-watching.user.js)
NOW_WATCHING_TOKEN=""

# /tech-note drafts from Claude Code (POST /api/posts/draft) — long random string
TECH_NOTE_TOKEN=""
